{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "market-dashboard-freqai-forecast",
  "initial_state": "running",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "trading_mode": "spot",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "1h",
  "cancel_open_orders_on_exit": true,
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "freqai": {
    "enabled": true,
    "identifier": "market-dashboard-return-v1",
    "purge_old_models": 2,
    "train_period_days": 60,
    "backtest_period_days": 7,
    "live_retrain_hours": 6,
    "expiration_hours": 12,
    "save_backtest_models": false,
    "feature_parameters": {
      "include_timeframes": [
        "1h",
        "4h"
      ],
      "include_corr_pairlist": [
        "BTC/USDT",
        "ETH/USDT"
      ],
      "label_period_candles": 24,
      "include_shifted_candles": 2,
      "indicator_periods_candles": [
        10,
        20,
        40
      ],
      "DI_threshold": 1.0,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "plot_feature_importances": 10
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "shuffle": false,
      "random_state": 42
    },
    "model_training_parameters": {}
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "username": "freqai",
    "password": "disabled",
    "jwt_secret_key": "change-me-before-enabling-api-1234567890"
  },
  "internals": {
    "process_throttle_secs": 5
  }
}
